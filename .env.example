VOICE_AGENT_MODE=mock
VOICE_AGENT_HOST=0.0.0.0
VOICE_AGENT_PORT=8000
# Optional deployment fallback used by some platforms. VOICE_AGENT_PORT wins if both are set.
PORT=
VOICE_AGENT_WS_PING_INTERVAL=30
VOICE_AGENT_WS_PING_TIMEOUT=120
VOICE_AGENT_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Required only when VOICE_AGENT_MODE=live.
DEEPGRAM_API_KEY=
GROQ_API_KEY=
ELEVENLABS_API_KEY=
# Optional. Only needed to A/B the OpenRouter models in the UI model picker (Claude,
# GPT-4o-mini, Gemini, Llama…). Groq models work without it. Get one at openrouter.ai.
OPENROUTER_API_KEY=

# Live-mode tuning placeholders.
DEEPGRAM_MODEL=nova-3
DEEPGRAM_ENDPOINTING_MS=200
DEEPGRAM_UTTERANCE_END_MS=1000
VOICE_AGENT_PARTIAL_IDLE_FINALIZE_MS=500
VOICE_AGENT_INPUT_GAIN=2.0
VOICE_AGENT_INTENT_INFERENCE_ENABLED=true
VOICE_AGENT_CONVERSATION_FLOW_ENABLED=true
# NOTE: the LLM is now chosen from the Pipecat page's model picker (a curated Groq +
# OpenRouter list — see app/llm_models.py MODELS) so you can A/B models on a live call.
# GROQ_MODEL below is no longer read by the pipeline; edit MODELS to change options.
GROQ_MODEL=openai/gpt-oss-120b
# Which model is active when the UI sends none (a key in app/llm_models.py MODELS).
# The UI picker overrides this per session and persists your choice to data/active_model.
DEFAULT_MODEL=groq-gpt-oss-120b
GROQ_TEMPERATURE=0.8
# GPT-OSS supports low/medium/high. Low keeps casual calls responsive.
GROQ_REASONING_EFFORT=low
# Caps reply length to voice-appropriate size. 0 = no cap. Applied to every model.
GROQ_MAX_TOKENS=320

# Pipecat turn-taking. Smart turn is a local end-of-turn model: it waits through
# mid-thought pauses (up to its stop_secs ceiling) instead of jumping in.
# VOICE_AGENT_SMART_TURN_ENABLED=true
# VOICE_AGENT_SMART_TURN_STOP_SECS=3.0
# Flat pause threshold used only when smart turn is disabled.
# VOICE_AGENT_SPEECH_TIMEOUT_STOP_SECS=0.8
# Words required before barge-in interrupts the bot (noise immunity). 0 = any speech interrupts.
# VOICE_AGENT_INTERRUPT_MIN_WORDS=2
# Silero VAD tuning. Keep stop_secs at 0.2 with smart turn enabled.
# VOICE_AGENT_VAD_CONFIDENCE=0.7
# VOICE_AGENT_VAD_START_SECS=0.2
# VOICE_AGENT_VAD_STOP_SECS=0.2
# VOICE_AGENT_VAD_MIN_VOLUME=0.6
# ElevenLabs TTS. v3 (eleven_v3) is NOT available on the realtime WebSocket the
# pipeline uses — keep a streaming model (eleven_flash_v2_5 / eleven_turbo_v2_5).
ELEVENLABS_MODEL=eleven_flash_v2_5
# Fallback/default voice. The active voice can also be chosen from the UI
# (Pipecat page), which persists to data/active_voice_id and overrides this.
ELEVENLABS_VOICE_ID=
# 24000 = noticeably more present in the browser; Twilio is transcoded to 8k regardless.
ELEVENLABS_SAMPLE_RATE=24000
ELEVENLABS_SPEED=1.0
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.8
ELEVENLABS_STYLE=0.0
ELEVENLABS_USE_SPEAKER_BOOST=false
ELEVENLABS_OPEN_TIMEOUT_SECONDS=8
ELEVENLABS_CONNECT_RETRIES=1
VOICE_AGENT_PERSONA="You are a concise, warm voice on an ambiguous open phone call. Sound present and spoken, as if you are still on the line with the caller. Keep replies brief, natural, and phone-call appropriate. Never sound like a web chat assistant."

# Twilio inbound and website-initiated outbound calling. The server must be
# publicly reachable for Twilio to connect.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Required for outbound calls. Use a Twilio number or verified outgoing caller ID in E.164 format.
TWILIO_FROM_NUMBER=
# Required to enable the website's outbound dialer. Generate a strong random value
# (for example: openssl rand -hex 32) and enter it in the page when placing a call.
VOICE_AGENT_OUTBOUND_ACCESS_TOKEN=
# Public hostname only (no scheme, no path), e.g. voice.example.com. Used to build the
# HTTPS callback and wss:// Media Streams URLs.
PUBLIC_HOST=

# Browser-local ambience. This is played only in the client output path, never sent to STT.
VOICE_AGENT_AMBIENCE_ENABLED=true
VOICE_AGENT_AMBIENCE_SCENE=room_line
VOICE_AGENT_AMBIENCE_VOLUME=0.035

# Proactive conversation tuning. "auto" enables mock/dev and requires explicit opt-in for live mode.
VOICE_AGENT_PROACTIVE_ENABLED=auto
# Optional overrides. Defaults are mode-aware: mock/demo nudges after 5s; live opt-in waits 30s and prompts once.
# VOICE_AGENT_PROACTIVE_GREETING_DELAY_MS=500
# VOICE_AGENT_PROACTIVE_SILENCE_TIMEOUT_MS=30000
# VOICE_AGENT_PROACTIVE_REPEAT_COOLDOWN_MS=60000
# VOICE_AGENT_PROACTIVE_MAX_CONSECUTIVE_PROMPTS=1
# VOICE_AGENT_PROACTIVE_FAILURE_BACKOFF_THRESHOLD=2
# VOICE_AGENT_PROACTIVE_FAILURE_BACKOFF_MS=30000
VOICE_AGENT_PROACTIVE_CONTEXTUAL_FOLLOWUPS_ENABLED=true

# Agent memory. "auto" enables in mock/dev and requires explicit opt-in for live mode.
# In-session summary survives long calls; cross-session memory recalls distilled facts.
VOICE_AGENT_MEMORY_ENABLED=auto
# Embeddings power semantic recall (RAG). Groq has no embeddings endpoint, so live mode
# uses OpenAI; without a key it falls back to a local deterministic embedder (no crash).
# OPENAI_API_KEY=
# VOICE_AGENT_MEMORY_EMBEDDING_PROVIDER=openai
# VOICE_AGENT_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# VOICE_AGENT_MEMORY_TOP_K=5
# VOICE_AGENT_MEMORY_DEDUPE_THRESHOLD=0.92
# VOICE_AGENT_MEMORY_DIR=data/memory
# VOICE_AGENT_MEMORY_SESSION_SUMMARY_ENABLED=true
